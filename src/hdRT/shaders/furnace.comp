#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

// furnace.comp - progressive Hydra scene path tracing with bounded opaque OpenPBR materials.
// (The file keeps its step 3 name so the build and the plugin resource path do not move.)
//
// One dispatch adds a bounded batch of samples per pixel: camera rays jittered inside a box filter one
// pixel wide), then a path. Each mesh has an object-space BLAS and a table row. The TLAS instance
// carries its transform and visibility; geometry stays resident across placement/color edits.
//
//   - A camera ray that hits nothing is black with alpha 0: the dome is never visible to the camera.
//   - The first hit plus `bounces` further surface bounces. A path that leaves the scene collects
//     throughput * dome radiance. A path still inside after its last allowed bounce contributes nothing.
//   - Unbound/fallback Lambertian: bounces are cosine-weighted about the shading normal, so each multiplies the
//     throughput by exactly the albedo; a sample below the geometric face ends the path. No clamping,
//     no Russian roulette, no denoiser.
//   - Bound OpenPBR: upstream eval/sample/pdf with texture LUTs; emitter proposals use full-BSDF MIS.
//   - A face seen from behind shades as if its normal pointed at the viewer, and blocks light like any
//     other (Karma does this whatever doubleSided says).
//
// RGB is accumulated per sample and alpha counts the camera rays that hit, so the averaged image is
// premultiplied by coverage.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

// Mirrors FrameGpu in vkFurnace.cpp. The matrices arrive in GfMatrix4d memory order (row-major, row
// vectors); read as a column-major mat4 that is the same transform for column vectors, so M * v is right.
layout(std430, set = 0, binding = 1) readonly buffer Frame
{
    mat4 invView;        // camera space -> world space
    mat4 invProj;        // normalised device coordinates -> camera space
    vec4 dome;           // rgb = uniform dome radiance, a = textured dome count
    uvec4 size;          // width, height, bounces, seed
    uvec4 pass;          // pass index, orthographic flag, unused, unused
} frame;

// One vec4 per pixel, row 0 at the bottom: rgb = summed radiance, a = number of camera rays that hit.
layout(std430, set = 0, binding = 2) buffer Accum
{
    vec4 sum[];
} accum;

// Absolute sample indices preserve the random streams across batch boundaries and pause/resume.
layout(push_constant) uniform Batch { uvec4 parameters; } batch;

// Exact 160-byte MeshRow layout in vkFurnace.cpp. Addresses refer to device-local data.
struct MeshGpu {
    uint64_t positions;
    uint64_t normals;
    uint64_t indices;
    uint64_t faceIds;
    vec4 albedo;
    ivec4 metadata;
    vec4 baseColorWeight;
    vec4 specularColorWeight;
    vec4 materialProperties;
    uint64_t uvs;
    uint64_t padding;
    ivec4 textures0;
    ivec4 textures1;
};
layout(std430, set = 0, binding = 3) readonly buffer MeshTable { MeshGpu rows[]; } meshes;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer FloatArray { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer IndexArray { uint v[]; };

const float T_MAX = 1.0e30;
const float PI = 3.14159265358979;

uint pcg_next(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// murmur3 finaliser: a full-avalanche 32-bit mix
uint mix32(uint h)
{
    h ^= h >> 16u;
    h *= 0x85EBCA6Bu;
    h ^= h >> 13u;
    h *= 0xC2B2AE35u;
    h ^= h >> 16u;
    return h;
}

float rand01(inout uint state)
{
    return float(pcg_next(state) >> 8u) * (1.0 / 16777216.0);
}

// OpenPBR's cosine sampler uses sqrt(u), so u=0 has zero PDF and discards a sample.
// All 23-bit bin midpoints are exactly representable in float32 and exclude BOTH
// endpoints. A 24-bit midpoint would round the largest value up to one.
float randOpen01(inout uint state)
{
    return (float(pcg_next(state) >> 9u) + 0.5) * (1.0 / 8388608.0);
}

// A direction about the unit normal n with density cos(theta) / pi.
vec3 cosine_hemisphere(vec3 n, inout uint rng)
{
    const float u1 = rand01(rng);
    const float u2 = rand01(rng);
    const float r = sqrt(u1);
    const float phi = 2.0 * PI * u2;
    const vec3 helper = abs(n.x) > 0.5 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 t = normalize(cross(helper, n));
    const vec3 b = cross(n, t);
    return normalize(r * cos(phi) * t + r * sin(phi) * b + sqrt(max(0.0, 1.0 - u1)) * n);
}

vec3 read_vertex(uint64_t address, uint v)
{
    FloatArray data = FloatArray(address);
    return vec3(data.v[3u * v], data.v[3u * v + 1u], data.v[3u * v + 2u]);
}

vec3 transformed_normal(uint64_t address, uint v, mat3 normalTransform)
{
    vec3 n = normalTransform * read_vertex(address, v);
    float len = length(n);
    return len > 0.0 && !isnan(len) && !isinf(len) ? n / len : vec3(0.0);
}

// Closest hit along `direction`. On a hit: the triangle and the barycentrics of the hit point.
bool trace(vec3 origin, vec3 direction, out uint mesh, out uint prim, out vec2 bary,
           out mat4x3 objectToWorld, out mat4x3 worldToObject, out float distance)
{
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, origin, 0.0, direction, T_MAX);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
        mesh = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
        bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        objectToWorld = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
        worldToObject = rayQueryGetIntersectionWorldToObjectEXT(rq, true);
        distance = rayQueryGetIntersectionTEXT(rq, true);
        return true;
    }
    prim = 0u;
    bary = vec2(0.0);
    distance = T_MAX;
    return false;
}

// The hit point, the geometric normal facing the incoming ray, and the shading normal on the same side.
// The shading normal is the interpolated smooth normal; if it is missing or degenerate, the face normal.
void surface(uint mesh, uint prim, vec2 bary, vec3 direction,
             mat4x3 objectToWorld, mat4x3 worldToObject, out vec3 p, out vec3 ng, out vec3 ns)
{
    MeshGpu data = meshes.rows[mesh];
    IndexArray indices = IndexArray(data.indices);
    const uint i0 = indices.v[3u * prim];
    const uint i1 = indices.v[3u * prim + 1u];
    const uint i2 = indices.v[3u * prim + 2u];
    const vec3 p0 = objectToWorld * vec4(read_vertex(data.positions, i0), 1.0);
    const vec3 p1 = objectToWorld * vec4(read_vertex(data.positions, i1), 1.0);
    const vec3 p2 = objectToWorld * vec4(read_vertex(data.positions, i2), 1.0);
    const float w0 = 1.0 - bary.x - bary.y;
    p = w0 * p0 + bary.x * p1 + bary.y * p2;

    vec3 g = cross(p1 - p0, p2 - p0);
    const float gl = length(g);
    g = (gl > 0.0) ? g / gl : -direction;
    if (dot(g, direction) > 0.0)
    {
        g = -g;   // seen from behind: shade as if the face pointed at the viewer
    }
    ng = g;

    // Match the original renderer: normalize transformed vertex normals before interpolation.
    mat3 normalTransform = transpose(mat3(worldToObject));
    vec3 s = w0 * transformed_normal(data.normals, data.metadata.y != 0 ? 3u*prim : i0, normalTransform)
           + bary.x * transformed_normal(data.normals, data.metadata.y != 0 ? 3u*prim+1u : i1, normalTransform)
           + bary.y * transformed_normal(data.normals, data.metadata.y != 0 ? 3u*prim+2u : i2, normalTransform);
    const float sl = length(s);
    if (!(sl > 1.0e-12) || isnan(sl) || isinf(sl))
    {
        s = g;
    }
    else
    {
        s /= sl;
        if (dot(s, g) < 0.0)
        {
            s = -s;   // keep the shading normal on the side the ray arrived from
        }
    }
    ns = s;
}

#include "textures.glsl"
#include "material.glsl"
#include "lighting.glsl"
#include "environment.glsl"
#include "guides.glsl"

// Radiance along one camera ray, and whether the camera ray hit anything.
vec3 path(vec3 origin, vec3 direction, inout uint rng, out bool covered)
{
    const uint budget = frame.size.z;
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);
    covered = false;
    float previousPdf = 0.0;
    bool previousDelta = false;

    // Segment 0 is the camera ray; segment k > 0 leaves the k-th hit. Hits 1 .. budget+1 scatter.
    for (uint seg = 0u; seg <= budget + 1u; ++seg)
    {
        uint mesh, prim;
        vec2 bary;
        mat4x3 objectToWorld, worldToObject;
        float meshDistance;
        bool hitMesh = trace(origin, direction, mesh, prim, bary, objectToWorld, worldToObject, meshDistance);
        float lightDistance; vec3 lightNormal; uint lightIndex;
        if (closestLight(origin, direction, meshDistance, lightIndex, lightDistance, lightNormal)) {
            LightGpu light = lights.rows[lightIndex];
            float cosine = dot(lightNormal, -direction);
            if (cosine > 0.0) {
                float lightPdf = light.radiance.w * lightDistance*lightDistance / (light.basisUArea.w*cosine);
                radiance += throughput * (seg == 0u ? light.selection.yzw :
                    light.radiance.rgb * (previousDelta ? 1.0 : powerWeight(previousPdf, lightPdf)));
            }
            if (seg == 0u) covered = true;
            break;
        }
        if (!hitMesh)
        {
            if (seg > 0u)
            {
                radiance += throughput * (frame.dome.a > 0.0 ?
                    environmentValue(direction)*(previousDelta ? 1.0 : powerWeight(previousPdf,environmentPdf(direction))) : frame.dome.rgb);
                radiance += throughput * distantEmission(direction, previousPdf, previousDelta);
            }
            break;                                         // a camera miss stays black, alpha 0
        }
        if (seg == 0u)
        {
            covered = true;
        }
        if (seg == budget + 1u)
        {
            break;   // still inside the scene after the last allowed bounce: nothing
        }

        vec3 p, ng, ns;
        surface(mesh, prim, bary, direction, objectToWorld, worldToObject, p, ng, ns);

        // Offset along the geometric normal, scaled with the magnitude of the position.
        const float m = max(1.0, max(abs(p.x), max(abs(p.y), abs(p.z))));
        origin = p + ng * (1.0e-4 * m);
        if (meshes.rows[mesh].metadata.z != 0) {
            if (dot(ns, -direction) <= 0.0) break;
            MeshGpu material = texturedMaterial(meshes.rows[mesh], prim, bary);
            OpenPBR_PreparedBsdf bsdf = prepareMaterial(material, ns, -direction);
            if (frame.pass.z > 0u) radiance += throughput * directMaterialLight(origin, ng, ns, bsdf, rng);
            if (frame.dome.a > 0.0) radiance += throughput * directMaterialEnvironment(origin, ng, ns, bsdf, rng);
            OpenPBR_DiffuseSpecular weight;
            OpenPBR_BsdfLobeType lobe;
            vec3 randoms = vec3(randOpen01(rng), randOpen01(rng), randOpen01(rng));
            openpbr_sample(bsdf, randoms, direction, weight, previousPdf, lobe);
            if (previousPdf <= 0.0 || dot(direction, ng) <= 0.0) break;
            throughput *= openpbr_get_sum_of_diffuse_specular(weight);
            previousDelta = bool(lobe & OpenPBR_BsdfLobeTypeSpecular);
            continue;
        }
        throughput *= meshes.rows[mesh].albedo.rgb;
        previousDelta = false;
        if (frame.pass.z > 0u) radiance += throughput * directLight(origin, ng, ns, rng);
        if (frame.dome.a > 0.0) radiance += throughput * directEnvironment(origin, ng, ns, rng);
        // Cosine about the shading normal. A sample that falls below the geometric face carries no light
        // (the Lambert BRDF with a shading normal is zero there), so the path ends. Measured against Karma
        // CPU on nonce 101 (C6, 2026-11-11): mirroring such samples back up added a +0.1% bias and doubled
        // the FLIP gap (per-pixel residual against Karma, noise removed, about 2%); ending the path or
        // sampling about the face normal leaves about 1%, a level within 0.05%. Not zero: see DECISIONS.md.
        direction = cosine_hemisphere(ns, rng);
        previousPdf = max(0.0, dot(ns, direction)) / PI;
        if (dot(direction, ng) <= 0.0)
        {
            break;
        }
    }
    return radiance;
}

vec4 traceSample(uvec2 pixel, uint sampleIndex)
{
    const uint width = frame.size.x;
    const uint height = frame.size.y;
    const uint index = pixel.y * width + pixel.x;

    // One decorrelated stream per pixel per pass: hash the path number, mix in the seed, hash again.
    const uint path_number = sampleIndex * (width * height) + index;
    uint rng = mix32(frame.size.w + mix32(path_number + 0x9E3779B9u));

    // Pixel -> normalised device coordinates, jittered uniformly inside the pixel (a one-pixel box).
    // Row 0 is the bottom of the image (y = -1).
    const vec2 jitter = vec2(rand01(rng), rand01(rng));
    const vec2 ndc = 2.0 * ((vec2(pixel) + jitter) / vec2(float(width), float(height))) - 1.0;

    // Un-project the pixel onto the near plane, then into the world.
    const vec4 near_h = frame.invProj * vec4(ndc, -1.0, 1.0);
    const vec3 near_point = near_h.xyz / near_h.w;
    vec3 origin;
    vec3 direction;
    if (frame.pass.y != 0u)
    {
        // orthographic: parallel rays leave the near plane
        origin = (frame.invView * vec4(near_point, 1.0)).xyz;
        direction = normalize((frame.invView * vec4(0.0, 0.0, -1.0, 0.0)).xyz);
    }
    else
    {
        // perspective: rays leave the eye through the near plane
        origin = (frame.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        direction = normalize((frame.invView * vec4(near_point, 0.0)).xyz);
    }

    bool covered;
    const vec3 radiance = path(origin, direction, rng, covered);
    return vec4(radiance, covered ? 1.0 : 0.0);
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= frame.size.x || pixel.y >= frame.size.y)
        return;
    const uint index = pixel.y * frame.size.x + pixel.x;
    if (frame.pass.w != 0u && batch.parameters.x == 0u) writeGuide(pixel, index);
    // Add each sample to the existing sum in order. A separate batch subtotal would change
    // floating-point grouping, making the image depend on how interactive work was scheduled.
    precise vec4 running = accum.sum[index];
    for (uint k = 0u; k < batch.parameters.y; ++k)
        running += traceSample(pixel, batch.parameters.x + k);
    accum.sum[index] = running;
}
