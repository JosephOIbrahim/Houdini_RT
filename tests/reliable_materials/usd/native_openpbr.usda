#usda 1.0
(
    doc = """Generated from Composed Stage of root layer 
"""
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
)

def HoudiniLayerInfo "HoudiniLayerInfo" (
    customData = {
        int HoudiniCreatorNode = 10
        int[] HoudiniEditorNodes = [10, 11, 21]
        string HoudiniSaveControl = "Placeholder"
    }
)
{
}

def "World"
{
    def Mesh "mesh" (
        apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </materials/openpbr>
        point3f[] points = [(-2, -2, 0), (2, -2, 0), (2, 2, 0), (-2, 2, 0)]
        color3f[] primvars:displayColor = [(0.9, 0.1, 0.1)]
        uniform token subdivisionScheme = "none"
    }

    def DomeLight "dome"
    {
        float inputs:intensity = 1
    }
}

def Camera "Camera"
{
    float horizontalAperture = 60
    token projection = "orthographic"
    float verticalAperture = 60
    double3 xformOp:translate = (0, 0, 5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </Camera>
        custom int houdinirt:spp = 4
        uniform int2 resolution = (64, 64)
    }
}

def Scope "materials"
{
    def Material "openpbr" (
        apiSchemas = ["MaterialXConfigAPI"]
        customData = {
            int[] HoudiniPrimEditorNodes = [12]
        }
    )
    {
        string config:mtlx:version = "1.39"
        token outputs:mtlx:displacement.connect = </materials/openpbr/mtlxdisplacement.outputs:out>
        token outputs:mtlx:surface.connect = </materials/openpbr/surface.outputs:out>

        def Shader "surface" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.4, 0.7)
            float inputs:specular_roughness = 0.45
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (0, 0)
        }

        def Shader "mtlxdisplacement" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:id = "ND_displacement_float"
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-0.2883, -2.4334)
        }
    }
}

