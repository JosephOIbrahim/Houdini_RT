{
  "version": 1,
  "default": "houdini_rt_sidecar",
  "targets": {
    "houdini_rt_sidecar": {
      "home": "$HOUDINI_RT_ROOT",
      "python_version": "3.14",
      "site_packages": "${HOUDINI_RT_ROOT}/Lib/site-packages",
      "entry_point": "synapse.cognitive.agent_loop.run_turn",
      "mode": "sidecar",
      "sidecar": {
        "launcher": "${HOUDINI_RT_ROOT}/python.exe",
        "package_precedence": "runtime-first"
      }
    },
    "houdini_rt_in_process": {
      "home": "$HOUDINI_RT_ROOT",
      "python_version": "3.14",
      "site_packages": "${HOUDINI_RT_ROOT}/Lib/site-packages",
      "entry_point": null,
      "env": {},
      "allow_pure_python_only": false
    }
  }
}
