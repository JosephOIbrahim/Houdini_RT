#version 460
#extension GL_EXT_ray_query : require

// furnace.comp - the step 4 kernel: Lambertian path tracing of the Hydra scene under a uniform dome.
// (The file keeps its step 3 name so the build and the plugin resource path do not move.)
//
// One dispatch adds one sample to every pixel: a camera ray jittered inside its pixel (a box filter one
// pixel wide), then a path. The scene is one world-space triangle mesh (the render pass flattens every
// Hydra mesh, transforms applied); each triangle carries its albedo. Contract, from the exam header:
//
//   - A camera ray that hits nothing is black with alpha 0: the dome is never visible to the camera.
//   - The first hit plus `bounces` further diffuse bounces. A path that leaves the scene collects
//     throughput * dome radiance. A path still inside after its last allowed bounce contributes nothing.
//   - Lambertian: bounces are cosine-weighted about the shading normal, so each one multiplies the
//     throughput by exactly the albedo; a sample below the geometric face ends the path. No clamping,
//     no Russian roulette, no denoiser.
//   - A face seen from behind shades as if its normal pointed at the viewer, and blocks light like any
//     other (Karma does this whatever doubleSided says).
//
// RGB is accumulated per sample and alpha counts the camera rays that hit, so the averaged image is
// premultiplied by coverage.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

// Mirrors FrameGpu in vkFurnace.cpp. The matrices arrive in GfMatrix4d memory order (row-major, row
// vectors); read as a column-major mat4 that is the same transform for column vectors, so M * v is right.
layout(std430, set = 0, binding = 1) readonly buffer Frame
{
    mat4 invView;        // camera space -> world space
    mat4 invProj;        // normalised device coordinates -> camera space
    vec4 dome;           // rgb = dome radiance, a unused
    uvec4 size;          // width, height, bounces, seed
    uvec4 pass;          // pass index, orthographic flag, unused, unused
} frame;

// One vec4 per pixel, row 0 at the bottom: rgb = summed radiance, a = number of camera rays that hit.
layout(std430, set = 0, binding = 2) buffer Accum
{
    vec4 sum[];
} accum;

// The flattened scene. Positions and normals are tightly packed xyz floats (std430 float arrays), the same
// memory the acceleration structure was built from.
layout(std430, set = 0, binding = 3) readonly buffer Positions { float p[]; } positions;
layout(std430, set = 0, binding = 4) readonly buffer Normals   { float n[]; } normals;
layout(std430, set = 0, binding = 5) readonly buffer Indices   { uint  i[]; } indices;
layout(std430, set = 0, binding = 6) readonly buffer Albedo    { vec4  a[]; } albedo;

const float T_MAX = 1.0e30;
const float PI = 3.14159265358979;

uint pcg_next(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    const uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

// murmur3 finaliser: a full-avalanche 32-bit mix
uint mix32(uint h)
{
    h ^= h >> 16u;
    h *= 0x85EBCA6Bu;
    h ^= h >> 13u;
    h *= 0xC2B2AE35u;
    h ^= h >> 16u;
    return h;
}

float rand01(inout uint state)
{
    return float(pcg_next(state) >> 8u) * (1.0 / 16777216.0);
}

// A direction about the unit normal n with density cos(theta) / pi.
vec3 cosine_hemisphere(vec3 n, inout uint rng)
{
    const float u1 = rand01(rng);
    const float u2 = rand01(rng);
    const float r = sqrt(u1);
    const float phi = 2.0 * PI * u2;
    const vec3 helper = abs(n.x) > 0.5 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 t = normalize(cross(helper, n));
    const vec3 b = cross(n, t);
    return normalize(r * cos(phi) * t + r * sin(phi) * b + sqrt(max(0.0, 1.0 - u1)) * n);
}

vec3 vertex_position(uint v)
{
    return vec3(positions.p[3u * v], positions.p[3u * v + 1u], positions.p[3u * v + 2u]);
}

vec3 vertex_normal(uint v)
{
    return vec3(normals.n[3u * v], normals.n[3u * v + 1u], normals.n[3u * v + 2u]);
}

// Closest hit along `direction`. On a hit: the triangle and the barycentrics of the hit point.
bool trace(vec3 origin, vec3 direction, out uint prim, out vec2 bary)
{
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, origin, 0.0, direction, T_MAX);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
        bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        return true;
    }
    prim = 0u;
    bary = vec2(0.0);
    return false;
}

// The hit point, the geometric normal facing the incoming ray, and the shading normal on the same side.
// The shading normal is the interpolated smooth normal; if it is missing or degenerate, the face normal.
void surface(uint prim, vec2 bary, vec3 direction, out vec3 p, out vec3 ng, out vec3 ns)
{
    const uint i0 = indices.i[3u * prim];
    const uint i1 = indices.i[3u * prim + 1u];
    const uint i2 = indices.i[3u * prim + 2u];
    const vec3 p0 = vertex_position(i0);
    const vec3 p1 = vertex_position(i1);
    const vec3 p2 = vertex_position(i2);
    const float w0 = 1.0 - bary.x - bary.y;
    p = w0 * p0 + bary.x * p1 + bary.y * p2;

    vec3 g = cross(p1 - p0, p2 - p0);
    const float gl = length(g);
    g = (gl > 0.0) ? g / gl : -direction;
    if (dot(g, direction) > 0.0)
    {
        g = -g;   // seen from behind: shade as if the face pointed at the viewer
    }
    ng = g;

    vec3 s = w0 * vertex_normal(i0) + bary.x * vertex_normal(i1) + bary.y * vertex_normal(i2);
    const float sl = length(s);
    if (!(sl > 1.0e-12) || isnan(sl) || isinf(sl))
    {
        s = g;
    }
    else
    {
        s /= sl;
        if (dot(s, g) < 0.0)
        {
            s = -s;   // keep the shading normal on the side the ray arrived from
        }
    }
    ns = s;
}

// Radiance along one camera ray, and whether the camera ray hit anything.
vec3 path(vec3 origin, vec3 direction, inout uint rng, out bool covered)
{
    const uint budget = frame.size.z;
    vec3 throughput = vec3(1.0);
    vec3 radiance = vec3(0.0);
    covered = false;

    // Segment 0 is the camera ray; segment k > 0 leaves the k-th hit. Hits 1 .. budget+1 scatter.
    for (uint seg = 0u; seg <= budget + 1u; ++seg)
    {
        uint prim;
        vec2 bary;
        if (!trace(origin, direction, prim, bary))
        {
            if (seg > 0u)
            {
                radiance += throughput * frame.dome.rgb;   // left the scene: the dome
            }
            break;                                         // a camera miss stays black, alpha 0
        }
        if (seg == 0u)
        {
            covered = true;
        }
        if (seg == budget + 1u)
        {
            break;   // still inside the scene after the last allowed bounce: nothing
        }

        vec3 p, ng, ns;
        surface(prim, bary, direction, p, ng, ns);
        throughput *= albedo.a[prim].rgb;

        // Offset along the geometric normal, scaled with the magnitude of the position.
        const float m = max(1.0, max(abs(p.x), max(abs(p.y), abs(p.z))));
        origin = p + ng * (1.0e-4 * m);
        // Cosine about the shading normal. A sample that falls below the geometric face carries no light
        // (the Lambert BRDF with a shading normal is zero there), so the path ends. Measured against Karma
        // CPU on nonce 101 (C6, 2026-11-11): mirroring such samples back up added a +0.1% bias and doubled
        // the FLIP gap; ending the path or sampling about the face normal both match Karma within noise.
        direction = cosine_hemisphere(ns, rng);
        if (dot(direction, ng) <= 0.0)
        {
            break;
        }
    }
    return radiance;
}

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uint width = frame.size.x;
    const uint height = frame.size.y;
    if (pixel.x >= width || pixel.y >= height)
    {
        return;
    }
    const uint index = pixel.y * width + pixel.x;

    // One decorrelated stream per pixel per pass: hash the path number, mix in the seed, hash again.
    const uint path_number = frame.pass.x * (width * height) + index;
    uint rng = mix32(frame.size.w + mix32(path_number + 0x9E3779B9u));

    // Pixel -> normalised device coordinates, jittered uniformly inside the pixel (a one-pixel box).
    // Row 0 is the bottom of the image (y = -1).
    const vec2 jitter = vec2(rand01(rng), rand01(rng));
    const vec2 ndc = 2.0 * ((vec2(pixel) + jitter) / vec2(float(width), float(height))) - 1.0;

    // Un-project the pixel onto the near plane, then into the world.
    const vec4 near_h = frame.invProj * vec4(ndc, -1.0, 1.0);
    const vec3 near_point = near_h.xyz / near_h.w;
    vec3 origin;
    vec3 direction;
    if (frame.pass.y != 0u)
    {
        // orthographic: parallel rays leave the near plane
        origin = (frame.invView * vec4(near_point, 1.0)).xyz;
        direction = normalize((frame.invView * vec4(0.0, 0.0, -1.0, 0.0)).xyz);
    }
    else
    {
        // perspective: rays leave the eye through the near plane
        origin = (frame.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        direction = normalize((frame.invView * vec4(near_point, 0.0)).xyz);
    }

    bool covered;
    const vec3 radiance = path(origin, direction, rng, covered);
    accum.sum[index] += vec4(radiance, covered ? 1.0 : 0.0);
}
