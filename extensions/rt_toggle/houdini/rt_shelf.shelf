        root = os.path.normpath(root)
        folders.extend([os.path.join(root, "houdini"), root])
    # Each HOUDINI_TOOLBAR_PATH entry is a folder that holds .shelf files, so it
    # is also where rt_shelf.py sits when the pair is copied to the user's
    # toolbar folder. Its parent is the extension root when that folder itself
    # is on the path. A copy install also needs RT_TOGGLE_ROOT, because
    # rt_runtime stays in the extension tree.
    for entry in (os.environ.get("HOUDINI_TOOLBAR_PATH") or "").split(os.pathsep):
        entry = entry.strip()
        if not entry:
            continue
        entry = os.path.normpath(entry.rstrip("\\/"))
        folders.extend([entry, os.path.dirname(entry)])
    if REPO:
        folders.extend([os.path.join(REPO, "houdini"), REPO])
    return folders


def _load_rt_shelf():
    try:
        import rt_shelf
        return rt_shelf
    except Exception:
        pass
    for folder in _candidates():
        if folder and os.path.isfile(os.path.join(folder, "rt_shelf.py")):
            if folder not in sys.path:
                sys.path.insert(0, folder)
            import rt_shelf
            return rt_shelf
    raise ImportError(
        "rt_shelf.py not found (checked RT_TOGGLE_ROOT and "
        "HOUDINI_TOOLBAR_PATH; keep rt_shelf.py beside this .shelf, "
        "or set RT_TOGGLE_ROOT)"
    )


try:
    _load_rt_shelf().pause_from_shelf(viewer=kwargs.get("pane"))
except Exception:
    _detail = traceback.format_exc(limit=1).strip().splitlines()[-1]
    print("HoudiniRT: shelf bootstrap failed - " + _detail)
    try:
        import hou
        hou.ui.setStatusMessage(
            "HoudiniRT: shelf bootstrap failed - " + _detail,
            hou.severityType.Error,
        )
    except Exception:
        pass
    ]]></script>
  </tool>

  <tool name="rt_turn" label="RT Turn" icon="$RT_TOGGLE_ROOT/houdini/icons/rt_turn.svg">
    <helpText><![CDATA[
      Submit one turn to the running HoudiniRT sidecar.

Asks for a prompt, submits with wait_ms=0, then polls for up to
RT_TURN_POLL_S seconds (default 2). If the turn is still running it
reports the request id; the RT Turn Cancel tool stops it. Offline
unless RT_SIDECAR_LIVE_MODEL=1 was set before Houdini started.
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import os
import sys
import traceback


def _load_rt_shelf():
    folders = []
    root = os.environ.get("RT_TOGGLE_ROOT") or ""
    if root:
        root = os.path.normpath(root)
        folders.extend([os.path.join(root, "houdini"), root])
    for entry in (os.environ.get("HOUDINI_TOOLBAR_PATH") or "").split(os.pathsep):
        entry = entry.strip()
        if not entry:
            continue
        entry = os.path.normpath(entry.rstrip("\/"))
        folders.extend([entry, os.path.dirname(entry)])
    for folder in folders:
        if folder and os.path.isfile(os.path.join(folder, "rt_shelf.py")):
            if folder not in sys.path:
                sys.path.insert(0, folder)
            import rt_shelf
            return rt_shelf
    raise ImportError(
        "rt_shelf.py not found (checked RT_TOGGLE_ROOT and "
        "HOUDINI_TOOLBAR_PATH; keep rt_shelf.py beside this .shelf, "
        "or set RT_TOGGLE_ROOT)"
    )


try:
    _load_rt_shelf().turn_from_shelf()
except Exception:
    _detail = traceback.format_exc(limit=1).strip().splitlines()[-1]
    print("HoudiniRT: shelf bootstrap failed - " + _detail)
    try:
        import hou
        hou.ui.setStatusMessage(
            "HoudiniRT: shelf bootstrap failed - " + _detail,
            hou.severityType.Error,
        )
    except Exception:
        pass
    ]]></script>
  </tool>

  <tool name="rt_turn_cancel" label="RT Turn Cancel" icon="$RT_TOGGLE_ROOT/houdini/icons/rt_turn_cancel.svg">
    <helpText><![CDATA[
      Cancel the most recent turn submitted from the RT Turn shelf tool.
    ]]></helpText>
    <toolMenuContext name="viewer">
      <contextNetType>OBJ</contextNetType>
      <contextNetType>SOP</contextNetType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import os
import sys
import traceback


def _load_rt_shelf():
    folders = []
    root = os.environ.get("RT_TOGGLE_ROOT") or ""
    if root:
        root = os.path.normpath(root)
        folders.extend([os.path.join(root, "houdini"), root])
    for entry in (os.environ.get("HOUDINI_TOOLBAR_PATH") or "").split(os.pathsep):
        entry = entry.strip()
        if not entry:
            continue
        entry = os.path.normpath(entry.rstrip("\/"))
        folders.extend([entry, os.path.dirname(entry)])
    for folder in folders:
        if folder and os.path.isfile(os.path.join(folder, "rt_shelf.py")):
            if folder not in sys.path:
                sys.path.insert(0, folder)
            import rt_shelf
            return rt_shelf
    raise ImportError(
        "rt_shelf.py not found (checked RT_TOGGLE_ROOT and "
        "HOUDINI_TOOLBAR_PATH; keep rt_shelf.py beside this .shelf, "
        "or set RT_TOGGLE_ROOT)"
    )


try:
    _load_rt_shelf().cancel_turn_from_shelf()
except Exception:
    _detail = traceback.format_exc(limit=1).strip().splitlines()[-1]
    print("HoudiniRT: shelf bootstrap failed - " + _detail)
    try:
        import hou
        hou.ui.setStatusMessage(
            "HoudiniRT: shelf bootstrap failed - " + _detail,
            hou.severityType.Error,
        )
    except Exception:
        pass
    ]]></script>
  </tool>

</shelfDocument>
